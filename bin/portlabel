#!/bin/bash
#  PortLabel — CLI Entry Point (bin/portlabel)
#  Supports both direct subcommands and interactive menu

TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
BIN_DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
CORE_DIR="${BIN_DIR}/../core"

if [[ ! -f "${CORE_DIR}/engine.sh" ]]; then
    CORE_DIR="/usr/local/lib/portlabel/core"
fi

source "${CORE_DIR}/engine.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

print_success() { echo -e "  ${GREEN}✔${RESET} $1"; }
print_error()   { echo -e "  ${RED}✘${RESET} $1" >&2; }
print_warn()    { echo -e "  ${YELLOW}!${RESET} $1"; }
print_info()    { echo -e "  ${CYAN}→${RESET} $1"; }

pause() {
    echo ""
    read -rp "  Press Enter to continue..." _
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        print_error "Portlabel requires sudo privileges to manage /etc/hosts and Caddy."
        echo "Run: sudo portlabel $*"
        exit 1
    fi
}

#  Command Actions


cmd_add() {
    local name="$1"
    local port="$2"

    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

    if ! engine_validate_name "$name"; then
        print_error "Invalid name. Use lowercase letters, digits, or single hyphens (1-63 characters)."
        return 1
    fi

    if ! engine_validate_port "$port"; then
        print_error "Invalid port. Must be an integer between 1 and 65535."
        return 1
    fi

    if storage_get_by_name "$name" >/dev/null 2>&1; then
        print_error "${name}.local already exists. Use 'portlabel update' to change its port."
        return 1
    fi

    if storage_get_by_port "$port" >/dev/null 2>&1; then
        print_warn "Port ${port} is already assigned to another service."
    fi

    storage_add "$name" "$port" "enabled" || return 1
    engine_apply_all || return 1
    print_success "Created: ${name}.local → localhost:${port}"
    return 0
}

cmd_list() {
    local entries
    entries=$(storage_get_all)

    if [[ -z "$entries" ]]; then
        print_warn "No domains registered yet."
        return 0
    fi

    printf "  ${BOLD}%-20s %-8s %-25s %-10s${RESET}\n" "Service" "Port" "Address" "Status"
    echo "  ────────────────────────────────────────────────────────────"

    while IFS='|' read -r name port status; do
        [[ -z "$name" ]] && continue
        if [[ "$status" == "enabled" ]]; then
            status_colored="${GREEN}enabled${RESET}"
        else
            status_colored="${RED}disabled${RESET}"
        fi
        printf "  %-20s %-8s %-25s " "$name" "$port" "${name}.local"
        echo -e "$status_colored"
    done <<< "$entries"
    echo ""
    return 0
}

cmd_update() {
    local name="$1"
    local new_port="$2"

    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

    if ! storage_get_by_name "$name" >/dev/null 2>&1; then
        print_error "${name}.local not found."
        return 1
    fi

    if ! engine_validate_port "$new_port"; then
        print_error "Invalid port. Must be an integer between 1 and 65535."
        return 1
    fi

    storage_update_port "$name" "$new_port" || return 1
    engine_apply_all || return 1
    print_success "Updated: ${name}.local → localhost:${new_port}"
    return 0
}

cmd_toggle() {
    local name="$1"
    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

    if ! storage_get_by_name "$name" >/dev/null 2>&1; then
        print_error "${name}.local not found."
        return 1
    fi

    local new_status
    new_status=$(storage_toggle_status "$name") || return 1
    engine_apply_all || return 1
    print_success "${name}.local is now ${new_status}"
    return 0
}

cmd_remove() {
    local name="$1"
    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

    if ! storage_get_by_name "$name" >/dev/null 2>&1; then
        print_error "${name}.local not found."
        return 1
    fi

    storage_remove "$name" || return 1
    engine_apply_all || return 1
    print_success "Removed: ${name}.local"
    return 0
}

#  Interactive CLI menu

menu_header() {
    clear
    echo -e "${BOLD}${CYAN}"
    echo "  ██████╗  ██████╗ ██████╗ ████████╗██╗      █████╗ ██████╗ ███████╗██╗     "
    echo "  ██╔══██╗██╔═══██╗██╔══██╗╚══██╔══╝██║     ██╔══██╗██╔══██╗██╔════╝██║     "
    echo "  ██████╔╝██║   ██║██████╔╝   ██║   ██║     ███████║██████╔╝█████╗  ██║     "
    echo "  ██╔═══╝ ██║   ██║██╔══██╗   ██║   ██║     ██╔══██║██╔══██╗██╔══╝  ██║     "
    echo "  ██║     ╚██████╔╝██║  ██║   ██║   ███████╗██║  ██║██████╔╝███████╗███████╗"
    echo "  ╚═╝      ╚═════╝ ╚═╝  ╚═╝   ╚═╝   ╚══════╝╚═╝  ╚═╝╚═════╝ ╚══════╝╚══════╝"
    echo -e "${RESET}"
    echo -e "  ${CYAN}Local Domain Manager${RESET} — assign .local names to your self-hosted services"
    echo ""
}

menu_add() {
    echo -e "\n  ${BOLD}Create a new .local domain${RESET}\n"
    read -rp "  Service name (e.g. n8n, nextcloud): " name
    read -rp "  Port number: " port
    cmd_add "$name" "$port"
    pause
}

menu_update() {
    echo -e "\n  ${BOLD}Modify a domain${RESET}\n"
    cmd_list
    read -rp "  Enter service name to modify: " name
    local current_port
    current_port=$(storage_get_by_name "$name" | cut -d'|' -f2)
    read -rp "  New port [current: ${current_port}]: " new_port
    cmd_update "$name" "$new_port"
    pause
}

menu_toggle() {
    echo -e "\n  ${BOLD}Toggle a domain (enable / disable)${RESET}\n"
    cmd_list
    read -rp "  Enter service name to toggle: " name
    cmd_toggle "$name"
    pause
}

menu_remove() {
    echo -e "\n  ${BOLD}Delete a domain${RESET}\n"
    cmd_list
    read -rp "  Enter service name to delete: " name
    read -rp "  Delete ${name}.local? (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        cmd_remove "$name"
    else
        print_warn "Cancelled."
    fi
    pause
}

interactive_menu() {
    while true; do
        menu_header
        echo -e "  ${BOLD}Main Menu${RESET}\n"
        echo "    1) Add       — create a new .local domain"
        echo "    2) List      — view all registered domains"
        echo "    3) Update    — change a service port"
        echo "    4) Toggle    — enable or disable a domain"
        echo "    5) Remove    — delete a domain"
        echo "    6) Exit"
        echo ""
        read -rp "  Select an option [1-6]: " choice

        case "$choice" in
            1) menu_add ;;
            2) cmd_list; pause ;;
            3) menu_update ;;
            4) menu_toggle ;;
            5) menu_remove ;;
            6) echo ""; print_info "Goodbye."; echo ""; exit 0 ;;
            *) print_error "Invalid option. Please enter 1–6."; sleep 1 ;;
        esac
    done
}

#  Entry point router

storage_init

if [[ $# -eq 0 ]]; then
    require_root "$@"
    interactive_menu
fi

case "$1" in
    add)
        require_root "$@"
        [[ $# -ne 3 ]] && { echo "Usage: portlabel add <name> <port>"; exit 1; }
        cmd_add "$2" "$3"
        ;;
    list|ls)
        cmd_list
        ;;
    update)
        require_root "$@"
        [[ $# -ne 3 ]] && { echo "Usage: portlabel update <name> <port>"; exit 1; }
        cmd_update "$2" "$3"
        ;;
    toggle)
        require_root "$@"
        [[ $# -ne 2 ]] && { echo "Usage: portlabel toggle <name>"; exit 1; }
        cmd_toggle "$2"
        ;;
    remove|rm|delete)
        require_root "$@"
        [[ $# -ne 2 ]] && { echo "Usage: portlabel remove <name>"; exit 1; }
        cmd_remove "$2"
        ;;
    sync)
        require_root "$@"
        engine_apply_all && print_success "Hosts and Caddy synchronized."
        ;;
    help|--help|-h)
        echo "PortLabel v1.0 — Local Domain Manager"
        echo ""
        echo "Usage:"
        echo "  portlabel                      Open interactive menu"
        echo "  portlabel add <name> <port>    Add a new .local mapping"
        echo "  portlabel list                 List all registered domains"
        echo "  portlabel update <name> <port> Update the port of a domain"
        echo "  portlabel toggle <name>        Enable or disable a domain"
        echo "  portlabel remove <name>        Remove a domain mapping"
        echo "  portlabel sync                 Force resync /etc/hosts and Caddy"
        ;;
    *)
        print_error "Unknown command: $1. Run 'portlabel help' for usage."
        exit 1
        ;;
esac